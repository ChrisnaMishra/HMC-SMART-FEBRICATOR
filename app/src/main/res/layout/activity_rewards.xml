<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="22dp" android:background="@color/surface" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="Rewards" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Current points" android:textColor="@color/hulas_gray" android:layout_marginTop="25dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/points" android:textSize="48sp" android:textStyle="bold" android:textColor="@color/hulas_red" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Button android:id="@+id/scan" android:text="SCAN PIPE QR" android:backgroundTint="@color/hulas_red" android:textColor="@color/white" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:text="1 kg = 1 point. Points should be awarded only after Hulas backend verification." android:paddingTop="20dp" android:textColor="@color/hulas_gray" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>